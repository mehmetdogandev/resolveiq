# Base URL of the Rails API (no trailing slash, no /api suffix).
# Local: http://localhost:3001  Production: https://api-resolveiq.example.com
# NEXT_PUBLIC_* values are inlined at build time: redeploy on Vercel after changing it.
# Never put secrets here; everything prefixed NEXT_PUBLIC_ ships to the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
