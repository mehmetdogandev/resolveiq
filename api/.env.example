# ResolveIQ API environment variables.
# Local development needs none of these: config/database.yml defaults to the
# docker-compose Postgres (localhost:5434, user/password "resolveiq") and CORS
# defaults to http://localhost:3000. Set them in the Render dashboard for production.
# Never commit real values.

# Full Postgres connection string. Render injects it from the managed database.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Allowed browser origin(s) for CORS and the CSRF origin check, comma-separated.
# Required in production; the app refuses to boot without it.
FRONTEND_ORIGIN=https://resolveiq.example.com

# Hostnames the API answers to (DNS rebinding protection), comma-separated.
ALLOWED_HOSTS=api-resolveiq.example.com,.onrender.com

RAILS_ENV=production
# Signs session cookies. Render generates it (generateValue). No RAILS_MASTER_KEY is needed:
# this app does not use encrypted credentials.
SECRET_KEY_BASE=generate-with-bin-rails-secret
BUNDLE_WITHOUT=development:test
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=0

# Protects POST /api/v1/admin/demo_reset (header X-Admin-Token).
ADMIN_TOKEN=generate-a-long-random-string

# --- AI layer (server-side only, never exposed to the browser) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
# Estimated pricing, USD per 1M tokens.
OPENAI_PRICE_INPUT_PER_1M=0.15
OPENAI_PRICE_OUTPUT_PER_1M=0.60
# Set to 1 only to enable the deterministic, clearly labeled fallback when no key is configured.
AI_DEMO_MODE=0
